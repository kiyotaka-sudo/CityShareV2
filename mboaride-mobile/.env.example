# En développement, laissez ces lignes commentées : l'application utilise automatiquement
# l'adresse IP de l'ordinateur qui exécute Expo (le backend doit tourner sur ce même ordinateur, port 8080).
# Décommentez uniquement pour viser un autre serveur (ex. serveur de production).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api
# EXPO_PUBLIC_WS_URL=http://192.168.1.20:8080/ws
